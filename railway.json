{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx prisma generate"
  },
  "deploy": {
    "startCommand": "npx --no-install tsx scripts/agon-hq-daily.ts",
    "cronSchedule": "0 3 * * *",
    "restartPolicyType": "NEVER"
  }
}
